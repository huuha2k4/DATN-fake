{
  "expo": {
    "name": "Finora Personal Finance",
    "slug": "finora-personal-finance",
    "scheme": "finora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/modules/app/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.app"
    },
    "android": {
      "package": "com.finora.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/modules/app/assets/android-icon-foreground.png",
        "backgroundImage": "./src/modules/app/assets/android-icon-background.png",
        "monochromeImage": "./src/modules/app/assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ]
  }
}
