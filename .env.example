# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Tên project (Đổi tên này nếu chạy nhiều instance trên cùng 1 server)
COMPOSE_PROJECT_NAME=finance_app

# Ports
# NOTE: Trong production, chỉ WEB_PORT được expose ra ngoài
# Các port khác (API_PORT, FRONTEND_PORT, POSTGRES_PORT, REDIS_PORT) chỉ dùng internal
WEB_PORT=1116
API_PORT=8080
FRONTEND_PORT=5173

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod

# Security - JWT Token Configuration
# Generate new secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_please_generate_new_one
JWT_EXPIRATION=7200000

# Super Admin User
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=your_admin_password_here

# Frontend Configuration
VITE_API_URL=/api/v1

# AI / OCR Service
OCR_SERVICE_URL=http://ocr-service:8000
