# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Tên project (Đổi tên này nếu chạy nhiều instance trên cùng 1 server)
COMPOSE_PROJECT_NAME=finance_app

# Ports
# NOTE: Trong production, chỉ WEB_PORT được expose ra ngoài
# Các port khác (API_PORT, FRONTEND_PORT, POSTGRES_PORT, REDIS_PORT) chỉ dùng internal
WEB_PORT=1116
API_PORT=8080
FRONTEND_PORT=5173

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod

# Security - JWT Token Configuration
# Generate new secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_please_generate_new_one
JWT_EXPIRATION=7200000

# Super Admin User
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=your_admin_password_here

# Frontend Configuration
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_FINAI_TIMEOUT_MS=90000
VITE_AI_ANALYTICS_TIMEOUT_MS=40000
# Expo app: all AI traffic uses the Spring Boot API URL; no separate AI service URL.
EXPO_PUBLIC_API_URL=http://your-host:1116/api/v1
EXPO_PUBLIC_FINAI_TIMEOUT_MS=90000
EXPO_PUBLIC_AI_ANALYTICS_TIMEOUT_MS=40000

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Mail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# AI Service
GEMINI_API_KEY=your_gemini_api_key_here
USE_LOCAL_LLM=false
LOCAL_MODEL_NAME=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_MODEL=gemini-flash-lite-latest
FINAI_SERVICE_SECRET=generate_a_different_32_character_secret_here
FINAI_INTERNAL_SECRET=generate_at_least_32_random_characters_here
FINAI_ACTION_TTL_MINUTES=15
FINAI_MODEL_TIMEOUT_SECONDS=18
ATTACHMENT_URL_TTL_SECONDS=300
FINAI_REQUEST_BUDGET_SECONDS=60
FINAI_TOOL_TIMEOUT_SECONDS=8
FINAI_DEADLINE_RESERVE_SECONDS=2
FINAI_MODEL_MAX_ATTEMPTS=2
FINAI_MAX_MODEL_ROUNDS=6
FINAI_MAX_TOOL_CALLS=8
FINAI_CONNECT_TIMEOUT_MS=3000
FINAI_READ_TIMEOUT_MS=70000
AI_ANALYTICS_CONNECT_TIMEOUT_MS=3000
AI_ANALYTICS_READ_TIMEOUT_MS=35000
GEMINI_VISION_TIMEOUT_SECONDS=15
SYSTEM_AUDIT_VIEW_PASSWORD=change-me-strong-system-audit-password
