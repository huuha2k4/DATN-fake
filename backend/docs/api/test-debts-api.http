Authorization: {{token}}
Content-Type: application/json

{
  "debt_type": "BORROWING",
  "creditor_name": "Ngân hàng BIDV",
  "principal_amount": 200000000,
  "currency_code": "VND",
  "interest_rate": 10.0,
  "interest_type": "FIXED",
  "start_date": "2026-05-01",
  "due_date": "2030-05-01",
  "payment_frequency": "MONTHLY",
  "payment_amount": 5000000,
  "description": "Vay kinh doanh"
}

###
POST {{baseUrl}}/debts
Authorization: {{token}}
Content-Type: application/json

{
  "debt_type": "LENDING",
  "debtor_name": "Phạm Văn D",
  "debtor_phone": "+84909999999",
  "principal_amount": 80000000,
  "currency_code": "VND",
  "interest_rate": 2.0,
  "interest_type": "FIXED",
  "start_date": "2026-07-01",
  "due_date": "2028-07-01",
  "payment_frequency": "QUARTERLY",
  "payment_amount": 11000000,
  "description": "Cho vay mua đất"
}

### 9.2. Scenario: Trả hết nợ và kiểm tra status
# Step 1: Tạo khoản nợ nhỏ
POST {{baseUrl}}/debts
Authorization: {{token}}
Content-Type: application/json

{
  "debt_type": "BORROWING",
  "creditor_name": "Test Creditor",
  "principal_amount": 5000000,
  "currency_code": "VND",
  "interest_rate": 0,
  "interest_type": "NONE",
  "start_date": "2026-10-01",
  "due_date": "2026-11-01",
  "payment_frequency": "ONE_TIME",
  "description": "Test trả hết nợ"
}

# Step 2: Note debt_id from response, then pay it all
# (Replace {debt_id} with actual ID)
###
POST {{baseUrl}}/debts/{debt_id}/payments
Authorization: {{token}}
Content-Type: application/json

{
  "amount": 5000000,
  "principal_paid": 5000000,
  "interest_paid": 0,
  "payment_date": "2026-10-15",
  "payment_method": "Tiền mặt",
  "note": "Trả hết một lần"
}

# Step 3: Verify status changed to PAID_OFF
###
GET {{baseUrl}}/debts/{debt_id}
Authorization: {{token}}

