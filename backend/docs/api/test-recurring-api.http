  "name": "Monthly reminder",
  "recurrence_rule": "FREQ=MONTHLY;BYMONTHDAY=1",
  "start_date": "2026-11-01",
  "reminder_message": "Monthly task"
}

# Yearly
POST {{baseUrl}}/schedules
Authorization: {{token}}
Content-Type: application/json

{
  "schedule_type": "REMINDER",
  "name": "Yearly reminder",
  "recurrence_rule": "FREQ=YEARLY;BYMONTH=1;BYMONTHDAY=1",
  "start_date": "2027-01-01",
  "reminder_message": "Happy New Year"
}

