Authorization: {{token}}
Content-Type: application/json

{
  "schedule_type": "TRANSACTION",
  "name": "Invalid dates",
  "recurrence_rule": "FREQ=DAILY",
  "start_date": "2026-10-11",
  "end_date": "2026-10-01",
