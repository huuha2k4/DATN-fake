Authorization: {{token}}
Content-Type: application/json

{
  "schedule_type": "REMINDER",
  "name": "Weekly reminder",
  "recurrence_rule": "FREQ=WEEKLY;BYDAY=MO",
  "start_date": "2026-10-13",
  "reminder_message": "Weekly task"
}

# Monthly
POST {{baseUrl}}/schedules
Authorization: {{token}}
Content-Type: application/json

{
